# GitHub OAuth App credentials (required for production /admin login)
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://YOUR_VERCEL_DOMAIN/api/callback
#
# Put real values in Vercel Environment Variables — never commit secrets here.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Defaults to https://<request-host>/api/callback
# OAUTH_REDIRECT_URL=https://YOUR_VERCEL_DOMAIN/api/callback

# Optional. Free contact-form delivery via https://web3forms.com
# Without this key, submissions still succeed in demo mode (logged server-side only).
WEB3FORMS_ACCESS_KEY=
